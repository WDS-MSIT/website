DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/msit
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Local MinIO defaults. Production can use Cloudflare R2 with the same adapter.
S3_ENABLED=true
S3_BUCKET=msit-media
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

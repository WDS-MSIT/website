DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/msit
PAYLOAD_SECRET=YOUR_SECRET_HERE
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_NAME=MSIT Administrator
SUPERADMIN_PASSWORD=CHANGE_ME

# Resend's test sender works locally with recipients such as delivered@resend.dev.
# Replace it with an address on a verified domain in deployed environments.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=onboarding@resend.dev
RESEND_FROM_NAME=MSIT CMS

# Local MinIO defaults. Production can use Cloudflare R2 with the same adapter.
S3_ENABLED=true
S3_BUCKET=msit-media
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
